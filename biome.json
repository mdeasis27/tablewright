{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "files": {
    "includes": [
      "**",
      "!.next",
      "!node_modules",
      "!fixtures",
      "!coverage",
      "!next-env.d.ts",
      "!gan-harness",
      "!docs"
    ]
  },
  "formatter": { "enabled": true, "indentStyle": "space", "indentWidth": 2, "lineWidth": 100 },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "suspicious": { "noExplicitAny": "error", "noTsIgnore": "error" }
    }
  },
  "css": { "formatter": { "enabled": true } }
}
